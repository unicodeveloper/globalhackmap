# Copy to .env.local and fill in what you have. Never commit real values.

# Mapbox public token (restrict it to your domains in the Mapbox dashboard)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Valyu API key: news extraction, daily brief, AI answers, research reports and explainers
VALYU_API_KEY=

# Absolute URL used in share cards, runbooks and llms.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authenticates the scheduled /api/cron/* routes (long random string)
CRON_SECRET=

# Required for production API and lookup protection. Use one shared Upstash Redis database
# for every instance and region. Missing credentials fail closed with HTTP 503 in production.
# Vercel integration aliases KV_REST_API_URL and KV_REST_API_TOKEN are also supported;
# when those exist, no duplicate UPSTASH_* variables are needed. Never use the read-only token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Recommended: higher upstream rate limits
GITHUB_TOKEN=
NVD_API_KEY=
CIRCL_API_KEY=
